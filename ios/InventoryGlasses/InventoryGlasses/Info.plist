	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Inventory Glasses</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>inventoryglasses</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>inventoryglasses://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string>L5WQ2DY43Y</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>InventoryGlasses needs Bluetooth to communicate with your Meta Ray-Ban glasses.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>InventoryGlasses uses Bluetooth to receive video frames from your Meta Ray-Ban glasses.</string>
	<key>NSCameraUsageDescription</key>
	<string>InventoryGlasses uses the camera to capture frames for inventory scanning (used as fallback when glasses are not connected).</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>InventoryGlasses sends video frames to your inventory server over the local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>InventoryGlasses uses the microphone for voice commands to switch scanning modes (e.g., say "Jarvis count").</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>InventoryGlasses uses your location to determine the warehouse when receiving pallets.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
